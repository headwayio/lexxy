<% blob_url = url_for(blob) %>
<% preview_url = rails_blob_path(blob, disposition: :inline) %>
<% extension = blob.filename.extension.downcase %>
<% icon_labels = { "pdf" => "PDF", "doc" => "DOC", "docx" => "DOC", "xls" => "XLS", "xlsx" => "XLS", "ppt" => "PPT", "pptx" => "PPT", "zip" => "ZIP", "rar" => "ZIP", "csv" => "CSV", "txt" => "TXT", "mp3" => "MP3", "wav" => "WAV", "ogg" => "OGG", "aac" => "AAC", "mp4" => "MP4", "mov" => "MOV", "webm" => "VID", "avi" => "VID", "gif" => "GIF" } %>
<% icon_label = icon_labels[extension] || extension.upcase %>

<% preview_action = link_to(preview_url, class: "attachment__action", target: "_blank", aria: { label: "Preview" }) { tag.svg(tag.path(d: "M9 4C5.13 4 1.86 6.42 0.5 9.5C1.86 12.58 5.13 15 9 15C12.87 15 16.14 12.58 17.5 9.5C16.14 6.42 12.87 4 9 4ZM9 13C6.79 13 5 11.21 5 9C5 6.79 6.79 5 9 5C11.21 5 13 6.79 13 9C13 11.21 11.21 13 9 13ZM9 6.5C7.62 6.5 6.5 7.62 6.5 9C6.5 10.38 7.62 11.5 9 11.5C10.38 11.5 11.5 10.38 11.5 9C11.5 7.62 10.38 6.5 9 6.5Z"), viewBox: "0 0 18 18", xmlns: "http://www.w3.org/2000/svg") } %>
<% download_action = link_to(blob_url, class: "attachment__action", download: blob.filename, aria: { label: "Download" }) { tag.svg(tag.path(d: "M9 12L4 7h3V2h4v5h3L9 12zM3 14h12v2H3v-2z"), viewBox: "0 0 18 18", xmlns: "http://www.w3.org/2000/svg") } %>
<% actions_html = tag.div(preview_action + download_action, class: "attachment__actions") %>
<% caption_html = tag.figcaption(class: "attachment__caption") {
  tag.span(blob.filename, class: "attachment__name") +
  tag.span(number_to_human_size(blob.byte_size), class: "attachment__size")
} %>

<% if blob.video? %>
  <figure class="attachment attachment--preview attachment--<%= extension %>">
    <div class="attachment__media">
      <%= tag.video controls: true, preload: "metadata" do %>
        <%= tag.source src: blob_url, type: blob.content_type %>
      <% end %>
      <%= actions_html %>
    </div>
    <%= caption_html %>
  </figure>

<% elsif blob.audio? %>
  <figure class="attachment attachment--audio attachment--<%= extension %>">
    <div class="attachment__file-info">
      <span class="attachment__icon"><%= icon_label %></span>
      <div class="attachment__caption">
        <span class="attachment__name"><%= blob.filename %></span>
        <span class="attachment__size"><%= number_to_human_size blob.byte_size %></span>
      </div>
      <%= actions_html %>
    </div>
    <%= tag.audio controls: true, preload: "metadata" do %>
      <%= tag.source src: blob_url, type: blob.content_type %>
    <% end %>
  </figure>

<% elsif blob.content_type == "image/gif" %>
  <figure class="attachment attachment--preview attachment--gif">
    <div class="attachment__media">
      <%= image_tag blob_url %>
      <%= actions_html %>
    </div>
    <%= caption_html %>
  </figure>

<% elsif blob.representable? %>
  <figure class="attachment attachment--preview attachment--<%= extension %>">
    <div class="attachment__media">
      <%= image_tag blob.representation(resize_to_limit: local_assigns[:in_gallery] ? [800, 600] : [1024, 768]) %>
      <%= actions_html %>
    </div>
    <%= caption_html %>
  </figure>

<% else %>
  <figure class="attachment attachment--file attachment--<%= extension %>">
    <span class="attachment__icon"><%= icon_label %></span>
    <%= caption_html %>
    <%= actions_html %>
  </figure>
<% end %>
