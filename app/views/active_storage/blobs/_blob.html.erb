<% extension = blob.filename.extension.downcase %>
<% icon_label = attachment_icon_label(extension) %>
<% actions = lexxy_attachment_actions(blob) %>

<% if blob.video? %>
  <figure class="attachment attachment--preview attachment--<%= extension %>">
    <div class="attachment__media">
      <%= tag.video controls: true, preload: "metadata" do %>
        <%= tag.source src: url_for(blob), type: blob.content_type %>
      <% end %>
    </div>
    <%= lexxy_attachment_preview_caption(blob, icon_label) %>
    <%= actions %>
  </figure>

<% elsif blob.audio? %>
  <figure class="attachment attachment--audio attachment--<%= extension %>">
    <div class="attachment__file-info">
      <span class="attachment__icon"><%= icon_label %></span>
      <%= lexxy_attachment_file_caption(blob) %>
      <%= actions %>
    </div>
    <%= tag.audio controls: true, preload: "metadata" do %>
      <%= tag.source src: url_for(blob), type: blob.content_type %>
    <% end %>
  </figure>

<% elsif %w[ image/gif image/webp image/avif image/svg+xml ].include?(blob.content_type) %>
  <%# Serve animated and vector image formats directly — going through %>
  <%# blob.representation strips animation (GIF/WebP/AVIF) or rasterizes (SVG). %>
  <figure class="attachment attachment--preview attachment--<%= extension %>">
    <div class="attachment__media">
      <%= lexxy_attachment_image_tag(blob) %>
    </div>
    <%= lexxy_attachment_preview_caption(blob, icon_label) %>
    <%= actions %>
  </figure>

<% elsif blob.representable? %>
  <figure class="attachment attachment--preview attachment--<%= extension %>">
    <div class="attachment__media">
      <%= image_tag blob.representation(resize_to_limit: local_assigns[:in_gallery] ? [800, 600] : [1024, 768]) %>
    </div>
    <%= lexxy_attachment_preview_caption(blob, icon_label) %>
    <%= actions %>
  </figure>

<% else %>
  <figure class="attachment attachment--file attachment--<%= extension %>">
    <span class="attachment__icon"><%= icon_label %></span>
    <%= lexxy_attachment_file_caption(blob) %>
    <%= actions %>
  </figure>
<% end %>
